  <modification type="public" template="post_macros" modification_key="warext_ai_manual_post_action" description="AI manuel analizini mesaj üç nokta moderatör eylemleri menüsüne ekler" execution_order="915" enabled="1" action="str_replace">
    <find><![CDATA[<xf:set var="$hasActionBarMenu" value="{{ false }}" />]]></find>
    <replace><![CDATA[<xf:set var="$hasActionBarMenu" value="{{ false }}" />
<xf:if is="$xf.visitor.hasPermission('general', 'warextAiReview') OR $xf.visitor.hasPermission('general', 'warextAiManage')">
    <a href="{{ link('warext-ai-manual/run', null, {'post_id': $post.post_id}) }}"
       class="actionBar-action actionBar-action--warextAi actionBar-action--menuItem js-warextAiManualAnalyze"
       data-post-id="{$post.post_id}"
       data-menu-closer="true">Bu mesajı AI ile analiz et</a>
    <xf:set var="$hasActionBarMenu" value="{{ true }}" />
</xf:if>]]></replace>
  </modification>

