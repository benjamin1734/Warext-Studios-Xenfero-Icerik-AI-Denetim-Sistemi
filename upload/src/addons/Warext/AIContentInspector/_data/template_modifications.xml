 data-detail-endpoint="{{ link('warext-ai/detail') }}"
 data-review-endpoint="{{ link('warext-ai/review') }}"></div>
<script src="{{ base_url('js/warext/ai-content-inspector/report-ui.js') }}?wai=1000380"></script>
