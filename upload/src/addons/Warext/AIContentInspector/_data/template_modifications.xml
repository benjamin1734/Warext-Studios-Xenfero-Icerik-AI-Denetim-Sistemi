    <find><![CDATA[</body>]]></find>
    <replace><![CDATA[
<xf:if is="$xf.options.warextAiEnabled">
<script src="{{ base_url('js/warext/ai-content-inspector/tracker.js') }}?wai=1000380"></script>
</xf:if>
<xf:if is="$xf.visitor.hasPermission('general', 'warextAiViewSimple')">
